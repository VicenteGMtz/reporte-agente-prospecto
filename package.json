{
  "name": "checkup-pdf-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx node_modules/@google-cloud/functions-framework/build/src/main.js --source=src/index.ts --target=generarPdf --port=8080",
    "build": "tsc && cp -r src/assets dist/ && rsync -av --include='*/' --include='*.html' --include='*.css' --exclude='*' src/templates/ dist/templates/",
    "gcp-build": "npm run build"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@google-cloud/functions-framework": "^5.0.5",
    "@sparticuz/chromium": "^131.0.1",
    "puppeteer": "^25.17.0",
    "puppeteer-core": "^25.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
